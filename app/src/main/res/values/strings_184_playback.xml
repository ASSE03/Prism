<resources>
    <!-- Playback → Shuffle (D57, #416). -->
    <string name="playback_shuffle_button">Shuffle button</string>
    <string name="playback_shuffle_button_info">Shuffle and Smart Shuffle: each tap goes from off to Shuffle to Smart Shuffle and back to off. Shuffle only: the button just turns Shuffle on and off.</string>
    <string name="playback_keep_shuffle">Keep shuffle on for the next list</string>
    <string name="playback_keep_shuffle_info">When the last queue was shuffled, a song you tap in a list plays first and the rest of that list is shuffled. Radios, single songs and videos are left alone.</string>
    <!-- Search words for the two rows above. -->
    <string name="playback_shuffle_keywords">smart shuffle random order mixed up stay shuffled</string>
    <!-- Playback: the group that holds Crossfade and its rows (its title can't be "Crossfade": that's the first row's name). -->
    <string name="playback_song_to_song">From one song to the next</string>
    <!-- Playback: the group with the two "when Prism starts" sliders. -->
    <string name="playback_speed_and_pitch">Speed and pitch</string>
    <!-- Sound & quality → Quality: Wi-Fi and mobile data quality as one row (its sheet names the two). -->
    <string name="sound_streaming_quality">Streaming quality</string>
    <string name="sound_wifi">Wi-Fi</string>
    <!-- The row's value: the quality on Wi-Fi (%1$s) and on mobile data (%2$s), e.g. "Wi-Fi High · Mobile data Normal". -->
